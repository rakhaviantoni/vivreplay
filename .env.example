# Used locally by Better Auth. Do not commit a real secret.
BETTER_AUTH_SECRET=replace-with-a-random-32-byte-secret
BETTER_AUTH_URL=http://localhost:3000
# Set the admin gate in Cloudflare Worker secrets and local .dev.vars.
ADMIN_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
# A Resend domain that you have verified, e.g. VivrePlay <noreply@vivreplay.com>
VIVREPLAY_EMAIL_FROM="VivrePlay <noreply@vivreplay.com>"

# Catalog, site images, and slab photos. Secret key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_JWKS_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
PARSE_API_KEY=

# iPaymu hosted checkout. Keep merchant credentials in Worker secrets, never NEXT_PUBLIC_*.
IPAYMU_VA=
IPAYMU_API_KEY=
IPAYMU_MODE=production
# Set true only after iPaymu has approved vivreplay.com and the request uses a registered static egress IP.
IPAYMU_PRODUCTION_READY=false
VIVREPLAY_PUBLIC_URL=https://vivreplay.com
VIVREPLAY_PRO_PRICE_IDR=
VIVREPLAY_PRO_DURATION_DAYS=
# Marketplace orders remain disabled until seller order/settlement operations are ready.
VIVREPLAY_MARKET_CHECKOUT_ENABLED=false
VIVREPLAY_MARKET_SELLER_OPERATIONS_READY=false
BITESHIP_API_KEY=
BITESHIP_WEBHOOK_SECRET=

# Cloudflare Turnstile. The site key is public; keep the secret in Worker secrets.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
