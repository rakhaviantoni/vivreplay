# Used locally by Better Auth. Do not commit a real secret.
BETTER_AUTH_SECRET=replace-with-a-random-32-byte-secret
BETTER_AUTH_URL=http://localhost:3000
# Set the admin gate in Cloudflare Worker secrets and local .dev.vars.
ADMIN_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
# A Resend domain that you have verified, e.g. VivrePlay <noreply@vivreplay.com>
VIVREPLAY_EMAIL_FROM="VivrePlay <noreply@vivreplay.com>"

# Catalog, site images, and slab photos. Secret key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_JWKS_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
PARSE_API_KEY=

# iPaymu hosted checkout. Keep merchant credentials in Worker secrets, never NEXT_PUBLIC_*.
IPAYMU_VA=
IPAYMU_API_KEY=
IPAYMU_MODE=production
# Production iPaymu API calls must go through the static-IP VPS relay.
IPAYMU_EGRESS_PROXY_URL=https://scan.vivreplay.com/api/ipaymu-egress
IPAYMU_EGRESS_PROXY_SECRET=
# Optional public HTTPS tunnel URL for local sandbox callbacks, ending in /api/checkout/ipaymu/callback.
IPAYMU_CALLBACK_URL=
# Set true only after iPaymu has approved vivreplay.com and the request uses a registered static egress IP.
IPAYMU_PRODUCTION_READY=false
VIVREPLAY_PUBLIC_URL=https://vivreplay.com
# Marketplace orders remain disabled until seller order/settlement operations are ready.
VIVREPLAY_MARKET_CHECKOUT_ENABLED=false
VIVREPLAY_MARKET_SELLER_OPERATIONS_READY=false
# Market payments accept iPaymu sandbox by default; require this flag before accepting live charges.
VIVREPLAY_MARKET_LIVE_PAYMENTS_ENABLED=false
BITESHIP_API_KEY=
BITESHIP_WEBHOOK_SECRET=

# Cloudflare Turnstile. The site key is public; keep the secret in Worker secrets.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Instagram/Facebook OAuth for PostForMe social publishing
# Client ID from Facebook App Dashboard
INSTAGRAM_APP_ID=1035188289654735
INSTAGRAM_APP_SECRET=
INSTAGRAM_CONFIG_ID=1455450343222088
INSTAGRAM_REDIRECT_URI=https://vivreplay.com/api/market/social/callback
# Alternative: use FACEBOOK_* naming (will fallback to these)
FACEBOOK_APP_ID=1035188289654735
FACEBOOK_APP_SECRET=

# Instagram Webhooks - for receiving real-time updates
# Webhook URL: https://vivreplay.com/api/webhooks/instagram
# Create a secure random token for webhook verification
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=vivreplay_instagram_webhook_2024

# WhatsApp Business API Webhooks
# Webhook URL: https://vivreplay.com/api/webhooks/whatsapp
WHATSAPP_WEBHOOK_VERIFY_TOKEN=vivreplay_whatsapp_webhook_2024
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Threads Webhooks
# Webhook URL: https://vivreplay.com/api/webhooks/threads
THREADS_WEBHOOK_VERIFY_TOKEN=vivreplay_threads_webhook_2024
THREADS_APP_SECRET=
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=
